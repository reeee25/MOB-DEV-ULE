        </a>
      </td>
      <td><?= esc($f['file_type']) ?></td>
      <td><?= number_format($f['file_size'] / 1024, 1) ?> KB</td>
      <td><?= $f['created_at'] ?></td>
      <td>
        <a href="/uploads/delete/<?= $f['id'] ?>"
           onclick="return confirm('Delete this file?')">Delete</a>
      </td>
    </tr>
    <?php endforeach; ?>
  </tbody>
